# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class

# Python virtual environments
.venv/
venv/
env/
ENV/

# ---------- Testing ----------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ---------- Type checking / linting ----------
.mypy_cache/
.pyre/
.ruff_cache/

# ---------- Build / Packaging ----------
build/
dist/
*.egg-info/
.eggs/

# ---------- Environment / Secrets ----------
.env
.env.*
!.env.example

# ---------- Database ----------
*.db
*.sqlite
*.sqlite3

# ---------- IDEs ----------
.vscode/
.idea/
*.iml

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs ----------
*.log
logs/

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- Temporary files ----------
*.tmp
*.temp
*.swp
*.swo
*~

# ---------- Node / Frontend ----------
node_modules/
.next/
out/
dist/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Coverage / Reports ----------
coverage/
reports/

# ---------- Local project files ----------
*.local

